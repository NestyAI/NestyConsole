# Public app metadata
NEXT_PUBLIC_APP_NAME=Nesty Console

# Optional default/fallback Gateway URL
NESTY_GATEWAY_URL=https://your-gateway.example.com

# Optional fallback Gateway API key.
# Console UI can override this with encrypted stored credentials.
NESTY_API_KEY=

# Stable server-side internal admin token fallback.
# Console UI can override this with encrypted stored credentials if needed.
NESTY_INTERNAL_ADMIN_TOKEN=

# Feature flags
NESTY_CONSOLE_ENABLE_INTERNAL_ADMIN=false

# Secret used to encrypt stored Gateway credentials.
NESTY_CONSOLE_CREDENTIALS_SECRET=

# Console admin login
NESTY_CONSOLE_ADMIN_USERNAME=admin
NESTY_CONSOLE_ADMIN_PASSWORD=
NESTY_CONSOLE_SESSION_SECRET=

# Disable credential SQLite storage (forces env-only mode, automatically active on Vercel)
NESTY_CONSOLE_DISABLE_CREDENTIAL_STORAGE=false
