# Public app metadata
NEXT_PUBLIC_APP_NAME=Nesty Console

# Optional default/fallback Gateway URL
NESTY_GATEWAY_URL=https://your-gateway.example.com

# Optional fallback Gateway API key.
# Console UI can override this with encrypted stored credentials.
NESTY_API_KEY=

# Stable server-side internal admin token fallback.
# Console UI can override this with encrypted stored credentials if needed.
NESTY_INTERNAL_ADMIN_TOKEN=

# Feature flags
NESTY_CONSOLE_ENABLE_INTERNAL_ADMIN=false

# Optional Console client auth for Gateway /internal/console/runtime/* and /internal/console/security/* routes.
# When set, Console server attaches X-Nesty-Console-ID and X-Nesty-Console-Secret on internal console proxy calls.
NESTY_CONSOLE_CLIENT_ID=default-console
NESTY_CONSOLE_CLIENT_SECRET=

# Secret used to encrypt stored Gateway credentials.
NESTY_CONSOLE_CREDENTIALS_SECRET=

# Credential storage mode:
# auto selects redis_kv when Upstash env vars exist.
# auto selects env_only on Vercel without Upstash.
# auto selects sqlite locally when no Upstash env exists.
# redis_kv stores encrypted credentials only.
NESTY_CONSOLE_CREDENTIAL_STORAGE=auto
NESTY_CONSOLE_STORAGE_PREFIX=nesty-console
UPSTASH_REDIS_REST_URL="https://ethical-civet-83363.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAUWjAAIgcDE5ZTA2OTYyYTNjNDU0YjllYTg0MWY1MzYyZGMyMzZkZg"

# Console admin login
NESTY_CONSOLE_ADMIN_USERNAME=admin
NESTY_CONSOLE_ADMIN_PASSWORD=
NESTY_CONSOLE_SESSION_SECRET=

# Backward compatibility: force env-only mode and disable persistent credential storage.
NESTY_CONSOLE_DISABLE_CREDENTIAL_STORAGE=false
